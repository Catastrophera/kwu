generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  email        String        @unique
  password     String
  transactions Transaction[]
  gachaLogs    GachaLog[]
  createdAt    DateTime      @default(now())
}

model Product {
  id              Int           @id @default(autoincrement())
  product_name    String
  price           Float
  stock           Int
  image_path      String
  is_gacha_eligible Boolean     @default(false)
  gachaLogs       GachaLog[]
}

model Transaction {
  id             String   @id @default(uuid())
  user_id        Int
  total_amount   Float
  payment_status String   @default("Pending")
  shipping_type  String   @default("Flat Rate")
  snap_token     String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [user_id], references: [id])
}

model GachaLog {
  id                  Int      @id @default(autoincrement())
  user_id             Int
  product_id_received Int
  created_at          DateTime @default(now())
  user                User     @relation(fields: [user_id], references: [id])
  product             Product  @relation(fields: [product_id_received], references: [id])
}
